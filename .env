# ==============================================================================
# FILE .env - Biến môi trường (Environment Variables)
# ==============================================================================
# LƯU Ý QUAN TRỌNG:
#   - File này chứa thông tin NHẠY CẢM, TUYỆT ĐỐI KHÔNG commit lên Git.
#   - Luôn thêm ".env" vào file .gitignore.
#   - Mỗi lập trình viên trong team sẽ tự tạo file .env riêng trên máy của mình.
#   - Thường có thêm file ".env.example" (không có giá trị thật) để làm mẫu cho team.
# ==============================================================================

# Cấu hình kết nối MySQL
# Cú pháp: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/student_db

# Khóa bí mật để ký JWT Token - Nên là một chuỗi ngẫu nhiên, dài và phức tạp
# Có thể tạo bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Danh sách domain được phép gọi API (CORS Whitelist) - dạng JSON list
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
